# Copy to .env, or generate it with: node vela-web/set-password.mjs <username> --generate
VELA_USERNAME=
VELA_PASSWORD_HASH=
VELA_SESSION_SECRET=

# Optional
VELA_GATEWAY_HOST=0.0.0.0
VELA_GATEWAY_PORT=8080
VELA_UPSTREAM_HOST=127.0.0.1
VELA_UPSTREAM_PORT=8081
VELA_SESSION_HOURS=12
VELA_SECURE_COOKIE=false   # set true once TLS terminates in front of the gateway
VELA_TRUST_PROXY=false     # set true only behind a proxy you control
VELA_WORKSPACE=
VELA_SERVER_DIR=

# --- Chat backend (OpenAI-compatible: OpenRouter, Groq, Together, Ollama, ...) ---
VELA_LLM_BASE_URL=https://openrouter.ai/api/v1
VELA_LLM_API_KEY=

# --- Model tiers. Jev picks a tier from how heavy the request is. ---
VELA_MODEL_SMALL=
VELA_MODEL_MEDIUM=
VELA_MODEL_LARGE=
VELA_FALLBACK_TIER=medium

# --- TypeSafe Jev, for routing. Without a key every request uses the fallback tier. ---
TYPESAFE_API_KEY=
VELA_JUDGE_MODEL=jev-latest
